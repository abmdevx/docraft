{
  "name": "docraft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Docraft converts pasted AI responses into polished Word, PDF and HTML files — fully local.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "samples": "tsx scripts/make-samples.ts"
  },
  "dependencies": {
    "docx": "^9.14.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "pdfmake": "^0.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.6",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
